#!/bin/bash
# Pre-push hook: Validates feature branch targeting
# Blocks task branches from pushing to master when epic has feature_branch set

# Color codes
RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
NC='\033[0m'

# FormalTask database path - use Python module for worktree-aware resolution
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
FORMALTASK_DB=$(PYTHONPATH="$REPO_ROOT" python3 -c "from formaltask.db.path import get_db_path; print(get_db_path())" 2>/dev/null) || FORMALTASK_DB="${PROJECT_ROOT:-$HOME/claude-code}/.claude/formaltask.db"

# Feature branch target validation - blocks task branches from pushing to master
# when their epic has a feature_branch set
check_feature_branch_target() {
    local branch="$1"
    local target_ref="$2"

    # Only check task branches
    if [[ ! "$branch" =~ ^task-([0-9]+) ]]; then
        return 0
    fi

    # Only check pushes to master/main
    if [[ "$target_ref" != "refs/heads/master" ]] && [[ "$target_ref" != "refs/heads/main" ]]; then
        return 0
    fi

    # Check if database exists
    if [[ ! -f "$FORMALTASK_DB" ]]; then
        return 0
    fi

    # Use Python checker for the actual logic
    local result
    result=$(python3 -c "
import sys
sys.path.insert(0, '${REPO_ROOT}')
from formaltask.validators.feature_branch import check_feature_branch_target
r = check_feature_branch_target('$branch', '$target_ref', '$FORMALTASK_DB')
if not r['allowed']:
    print(r['feature_branch'])
    sys.exit(1)
sys.exit(0)
" 2>/dev/null)

    if [[ $? -ne 0 ]] && [[ -n "$result" ]]; then
        echo ""
        echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
        echo -e "${RED}❌ PUSH BLOCKED - FEATURE BRANCH EPIC${NC}"
        echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
        echo ""
        echo -e "${YELLOW}This task belongs to an epic with feature branch isolation.${NC}"
        echo ""
        echo -e "${YELLOW}Target branch:${NC} ${result}"
        echo ""
        echo -e "${YELLOW}Create PR to the feature branch instead:${NC}"
        echo ""
        echo "  gh pr create --base ${result}"
        echo ""
        echo -e "${YELLOW}Or bypass with:${NC}"
        echo "  git push --no-verify"
        echo ""
        return 1
    fi

    return 0
}

# Read push parameters from stdin
while read local_ref local_sha remote_ref remote_sha; do
    current_branch=$(git branch --show-current)

    # Check if task branch should target a feature branch instead
    if ! check_feature_branch_target "$current_branch" "$remote_ref"; then
        exit 1
    fi
done

exit 0
